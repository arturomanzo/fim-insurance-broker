{
  "ci": {
    "collect": {
      "url": [
        "https://www.fimbroker.it/",
        "https://www.fimbroker.it/preventivo",
        "https://www.fimbroker.it/analizza-polizza",
        "https://www.fimbroker.it/broker-assicurativo-latina",
        "https://www.fimbroker.it/soluzioni/catastrofi-naturali",
        "https://www.fimbroker.it/soluzioni/scuole"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "color-contrast": ["error", { "minScore": 1 }],
        "meta-description": ["error", { "minScore": 1 }],
        "document-title": ["error", { "minScore": 1 }]
      }
    }
  }
}
